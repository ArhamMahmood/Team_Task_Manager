# Copy to backend/.env for local development.
NODE_ENV=development
PORT=3000

# Local Postgres from docker-compose.yml (TCP).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/team_task

# --- Cloud SQL (production on Cloud Run) ---
# When INSTANCE_CONNECTION_NAME is set, the app ignores DATABASE_URL and connects
# through the Unix socket at /cloudsql/<instance>.
# INSTANCE_CONNECTION_NAME=your-project:us-central1:team-task-db
# DB_USER=app
# DB_PASSWORD=change-me
# DB_NAME=team_task

# Any long random string. In production this is required.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_DAYS=7

# Leave unset in local dev (defaults to false); production defaults to true.
# COOKIE_SECURE=false
