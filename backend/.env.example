# Copy to backend/.env for local development.
NODE_ENV=development
PORT=3000

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/team_task

# Any long random string. In production this is required.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_DAYS=7

# Leave unset in local dev (defaults to false); production defaults to true.
# COOKIE_SECURE=false
